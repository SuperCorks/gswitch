{
  "name": "@supercorks/gswitch",
  "version": "1.4.0",
  "description": "Switch Google Cloud configurations and application default credentials",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperCorks/gswitch.git"
  },
  "license": "MIT",
  "author": "SuperCorks",
  "bin": {
    "gswitch": "bin/gswitch.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "gcloud",
    "google cloud",
    "cli",
    "configuration",
    "switch",
    "adc",
    "credentials"
  ],
  "dependencies": {
    "@inquirer/prompts": "^5.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "ora": "^8.0.0"
  },
  "scripts": {
    "start": "node bin/gswitch.js",
    "test": "vitest run",
    "release:inject-oauth-client": "node scripts/inject-oauth-client.js",
    "release:verify": "node scripts/inject-oauth-client.js --check",
    "prepublishOnly": "npm run release:verify"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
